# ---------------------------------------------------------------------------
# AI Recommendation Autopilot - environment
#
# Copy to .env and fill in. Every value here is a PLACEHOLDER; never commit a
# real secret. Configuration is parsed and validated once at startup by
# @autopilot/shared/env.ts, and a production deploy missing a required secret
# fails immediately rather than at 3am inside a worker.
#
# The product runs end to end with NONE of the provider keys set: it falls back
# to simulated providers, and everything it produces is labelled SYNTHETIC.
# ---------------------------------------------------------------------------

NODE_ENV=development
APP_ENV=local
APP_URL=http://localhost:3000
LOG_LEVEL=info

# --- Data stores ------------------------------------------------------------
# Required in production. Locally, tests use in-process Postgres (PGlite) and
# the queue runs in-process, so both may be left unset.
DATABASE_URL=postgres://autopilot:autopilot@localhost:5432/autopilot
REDIS_URL=redis://localhost:6379

# --- Secrets ----------------------------------------------------------------
# ENCRYPTION_KEY protects OAuth refresh tokens at rest (AES-256-GCM).
# Must decode to exactly 32 bytes:  openssl rand -base64 32
ENCRYPTION_KEY=
ENCRYPTION_KEY_VERSION=1
# openssl rand -base64 48
SESSION_SECRET=

# --- AI providers -----------------------------------------------------------
# Leave empty to run against simulated providers at zero cost.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Force simulation even when keys are present. Refused in production.
USE_MOCK_PROVIDERS=true

# --- Google Business Profile -------------------------------------------------
# OAuth only. The product never asks a customer for their Google password.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# --- Billing ----------------------------------------------------------------
# `mock` is a fully functional in-memory provider: real subscription states,
# correctly taxed invoices, signed webhooks. Swap for the production provider
# by implementing the PaymentProvider interface.
PAYMENT_PROVIDER=mock
PAYMENT_PROVIDER_KEY=
PAYMENT_WEBHOOK_SECRET=

# --- Agent safety envelope ---------------------------------------------------
# Hard ceilings for a single autonomous run. Lower is safer.
AGENT_MAX_SPEND_MINOR=1500
AGENT_MAX_ITERATIONS=25
AGENT_MAX_WALLCLOCK_MS=600000

# --- Crawler ----------------------------------------------------------------
CRAWLER_USER_AGENT=AIRecommendationAutopilotBot/0.1 (+https://example.com/bot)
CRAWLER_MAX_PAGES=120
CRAWLER_MAX_BYTES=5000000
CRAWLER_TIMEOUT_MS=15000
# DEVELOPMENT ONLY. Allows the crawler to reach private addresses so integration
# tests can hit a local fixture server. Refused in production, and for good
# reason: with this on, the crawler can reach your internal network.
CRAWLER_ALLOW_PRIVATE_HOSTS=false

# --- Observability ----------------------------------------------------------
SENTRY_DSN=
